  "texts": [
    {
      "type": {
        "id": 14,
        "name": "Réponse CF / Bureau"
      },
      "value": "Le Conseil fédéral propose d'accepter la motion."
    },
    {
      "type": {
        "id": 5,
        "name": "Texte déposé"
      },
      "value": "<p>Le Conseil fédéral est chargé :</p><p>1. de soumettre au Parlement une base légale ayant la teneur suivante : les réseaux sociaux proposant des services destinés aux consommateurs suisses disposent d'une représentation ou d'un domicile de notification en Suisse. La représentation ou le domicile de notification est l'interlocuteur des autorités suisses et permet aux consommateurs de faire facilement part de leurs éventuelles réclamations ;</p><p>2. de contribuer activement, au niveau international, à obtenir une solution au problème de l'application du droit sur Internet. Cette solution sera rapide et efficace, tout en respectant les principes de l'État de droit.</p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titre de l'objet"
      },
      "value": "Accès des autorités de poursuite pénale aux données conservées à l'étranger"
    }
  ],
  "title": "Accès des autorités de poursuite pénale aux données conservées à l'étranger"
}