    {
      "type": {
        "id": 5,
        "name": "Eingereichter Text"
      },
      "value": "<p><span style=\"color:black;\">Der Katalog der obligatorischen Landesverweisung in Art. 66a StGB sei dahingehend zu erweitern, dass auch Verurteilungen gemäss Art. 261bis StGB eine Landesverweisung zur Folge haben.</span></p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titel des Geschäftes"
      },
      "value": "Hassrede in den Katalog der Landesverweisung aufnehmen"
    }
  ],
  "title": "Hassrede in den Katalog der Landesverweisung aufnehmen"
