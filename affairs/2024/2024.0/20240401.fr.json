  "texts": [
    {
      "type": {
        "id": 5,
        "name": "Texte déposé"
      },
      "value": "<p><span style=\"color:black;\">Il convient d’étendre la liste des motifs d’expulsion obligatoire figurant à l’art. 66<i>a</i> CP de sorte que les condamnations visées à l’art. 261<sup>bis</sup> CP soient également punies d’une expulsion.</span></p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titre de l'objet"
      },
      "value": "Introduire le discours de haine dans la liste des motifs d'expulsion"
    }
  ],
  "title": "Introduire le discours de haine dans la liste des motifs d'expulsion"
}