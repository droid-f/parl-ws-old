  "texts": [
    {
      "type": {
        "id": 14,
        "name": "Antwort BR / Büro"
      },
      "value": "<div><p style=\"margin-top:0pt; margin-bottom:6pt; line-height:150%; widows:0; orphans:0; font-size:11pt\"><span style=\"font-family:Arial\">Die Motion bestärkt den Bundesrat darin, seine bisherigen Bemühungen zur Verteidigung unserer AOP und IGP im Rahmen der zur Verfügung stehenden finanziellen und personellen Ressourcen fortzusetzen.</span></p></div><br><br>Der Bundesrat beantragt die Annahme der Motion."
    },
    {
      "type": {
        "id": 5,
        "name": "Eingereichter Text"
      },
      "value": "<p><span style=\"color:black;\">Der Bundesrat wird beauftragt, sich stärker für die Einhaltung und die Anerkennung unserer AOP (Appellation d'Origine Protégée) und IGP (Indication Géographique Protégée) einzusetzen, und zwar nicht nur im Rahmen der Verhandlung zu Freihandelsabkommen, sondern auch gegenüber Ländern, die der Genfer Akte des Lissaboner Abkommens nicht beigetreten sind oder die nicht an Freihandelsabkommen gebunden sind.</span></p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titel des Geschäftes"
      },
      "value": "Stärkeres Engagement für die Einhaltung und die Anerkennung unserer AOP und IGP"
    }
  ],
  "title": "Stärkeres Engagement für die Einhaltung und die Anerkennung unserer AOP und IGP"
}