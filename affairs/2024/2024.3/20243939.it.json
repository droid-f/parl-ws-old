  "texts": [
    {
      "type": {
        "id": 6,
        "name": "Motivazione"
      },
      "value": "<div><p style=\"margin-top:0pt; margin-bottom:0pt; line-height:150%; widows:0; orphans:0; font-size:11pt\"><span style=\"font-family:Arial\">Alcuni Paesi europei dello spazio Schengen/Dublino stanno adottando misure sempre più restrittive, ad esempio limitando i ricongiungimenti familiari, aumentando gli allontanamenti di richiedenti l’asilo criminali o respinti, riducendo le possibilità giuridiche di impugnare le sentenze giudiziarie ecc. Degni di particolare attenzione sono i più recenti sviluppi in Paesi quali la Svezia, la Danimarca e i Paesi Bassi, che hanno chiaramente inasprito la loro politica d’asilo e migratoria.</span></p><p style=\"margin-top:0pt; margin-bottom:0pt; line-height:150%; widows:0; orphans:0; font-size:11pt\"><span style=\"font-family:Arial\">I Paesi Bassi prevedono ad esempio un’ampia riforma del loro sistema d’asilo volta a implementare una delle normative più rigide in Europa. Nel quadro di questa riforma intendono attuare misure di ampia portata per ridurre la migrazione.</span></p><p style=\"margin-top:0pt; margin-bottom:0pt; line-height:150%; widows:0; orphans:0; font-size:11pt\"><span style=\"font-family:Arial\">I risultati di questa analisi dovranno illustrare le ripercussioni per la Svizzera e le modifiche necessarie affinché il nostro Paese possa affrontare efficacemente le sfide attuali nel settore dell’asilo.</span></p></div>"
    },
    {
      "type": {
        "id": 14,
        "name": "Risposta del CF / Ufficio"
      },
      "value": "<p>Il Consiglio federale propone di accogliere il postulato.</p>"
    },
    {
      "type": {
        "id": 5,
        "name": "Testo depositato"
      },
      "value": "<div><p style=\"margin-top:0pt; margin-bottom:0pt; line-height:150%; widows:0; orphans:0; font-size:11pt\"><span style=\"font-family:Arial\">Il Consiglio federale è incaricato di analizzare la procedura d’asilo (recentemente inasprita) in Paesi europei selezionati nonché di valutare gli sviluppi e le riforme attuali in questi Paesi al fine di trarne (eventuali) conclusioni per la politica d’asilo svizzera.</span></p></div>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titolo dell'oggetto"
      },
      "value": "Analisi della procedura d'asilo in alcuni Paesi europei selezionati"
    }
  ],
  "title": "Analisi della procedura d'asilo in alcuni Paesi europei selezionati"
}