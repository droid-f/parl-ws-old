  "texts": [
    {
      "type": {
        "id": 6,
        "name": "Motivazione"
      },
      "value": "<div><p style=\"margin-top:0pt; margin-bottom:0pt; line-height:150%; widows:0; orphans:0; font-size:11pt\"><span style=\"font-family:Arial\">Nel suo rapporto del 24</span><span style=\"font-family:Arial\"> </span><span style=\"font-family:Arial\">gennaio 2024 in adempimento del postulato Caroni 20.4399 «Per una moderna legge sul Tribunale federale», il Consiglio federale ha formulato numerose proposte di miglioramenti tecnici facilmente attuabili e apparentemente incontestate, prospettando di porre in consultazione un pertinente avamprogetto. La presente mozione intende conferire il relativo mandato parlamentare.</span></p><p style=\"margin-top:0pt; margin-bottom:0pt; line-height:150%; widows:0; orphans:0; font-size:11pt\"><span style=\"font-family:Arial\"> </span></p><p style=\"margin-top:0pt; margin-bottom:0pt; line-height:150%; widows:0; orphans:0; font-size:11pt\"><span style=\"font-family:Arial\">L’avamprogetto non dovrà considerare ulteriori elementi, politicamente controversi, della fallita revisione del 2008 della legge sul Tribunale federale oppure alternative, come propone anche il Consiglio federale.</span></p></div>"
    },
    {
      "type": {
        "id": 14,
        "name": "Risposta del CF / Ufficio"
      },
      "value": "<p>Il Consiglio federale propone di accogliere la mozione.</p>"
    },
    {
      "type": {
        "id": 5,
        "name": "Testo depositato"
      },
      "value": "<div><p style=\"margin-top:0pt; margin-bottom:0pt; line-height:150%; widows:0; orphans:0; font-size:11pt\"><span style=\"font-family:Arial\">Il Consiglio federale è incaricato di presentare le modifiche legislative necessarie per attuare i miglioramenti tecnici della legislazione sul Tribunale federale conformemente al suo rapporto del 24</span><span style=\"font-family:Arial\"> </span><span style=\"font-family:Arial\">gennaio 2024 in adempimento del postulato 20.4399.</span></p></div>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titolo dell'oggetto"
      },
      "value": "Per una moderna legge sul Tribunale federale"
    }
  ],
  "title": "Per una moderna legge sul Tribunale federale"
}