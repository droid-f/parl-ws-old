  "texts": [
    {
      "type": {
        "id": 14,
        "name": "Risposta del CF / Ufficio"
      },
      "value": "Il Consiglio federale propone di accogliere il postulato."
    },
    {
      "type": {
        "id": 5,
        "name": "Testo depositato"
      },
      "value": "<p><span style=\"color:black;\">Il Consiglio federale è incaricato di presentare un rapporto sul mantenimento dei velivoli da combattimento F-5 Tiger, conformemente alla decisione del Parlamento di non metterli fuori servizio. Esso dovrà illustrare diverse varianti, ad esempio il loro possibile impiego nelle missioni Red Air (rappresentazione di obiettivi, tiri aria-aria ecc.). Per ogni variante andrà pure indicato il valore aggiunto per i partner delle Forze aeree a livello della politica di sicurezza nell’ambito della cooperazione militare. La Svizzera potrebbe ad esempio offrire, quale contributo attivo, l’impiego degli F-5 Tiger nel ruolo di Red Air nelle esercitazioni congiunte (internazionali) o dare in locazione/mettere a disposizione questi velivoli a Stati partner amici per le loro esercitazioni.</span></p><p>&nbsp;</p><p><span style=\"color:black;\">Una minoranza della Commissione (Hässig Patrick, Candan Hasan, Chappuis, Fivaz Fabien, Roth David, Schlatter) propone di respingere il postulato.</span></p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titolo dell'oggetto"
      },
      "value": "Mantenimento degli F-5 Tiger"
    }
  ],
  "title": "Mantenimento degli F-5 Tiger"
}