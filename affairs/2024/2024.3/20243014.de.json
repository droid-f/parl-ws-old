  "texts": [
    {
      "type": {
        "id": 14,
        "name": "Antwort BR / Büro"
      },
      "value": "<p>Der Bundesrat beantragt die Annahme des Postulates.</p>"
    },
    {
      "type": {
        "id": 5,
        "name": "Eingereichter Text"
      },
      "value": "<p><span style=\"color:black;\">Der Bundesrat wird beauftragt, zu prüfen und Bericht zu erstatten, wie sich die Teuerung auf die Tarife in der Krankenversicherung auswirkt, und welche Instrumente zur Verfügung stehen, um die Teuerungsentwicklung zu berücksichtigen. Insbesondere sind dabei die nichtärztlichen Leistungserbringenden zu beleuchten.</span></p><p>&nbsp;</p><p><span style=\"color:black;\">Eine Minderheit (Bircher, Aellen, Amaudruz, Glarner, Gutjahr, Hess Erich, Silberschmidt, Thalmann-Bieri, Vieze, Wyssmann) beantragt, das Postulat abzulehnen.</span></p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titel des Geschäftes"
      },
      "value": "Teuerungsausgleich bei Leistungserbringenden der obligatorischen Krankenpflegeversicherung"
    }
  ],
  "title": "Teuerungsausgleich bei Leistungserbringenden der obligatorischen Krankenpflegeversicherung"
}