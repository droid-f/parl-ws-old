  "texts": [
    {
      "type": {
        "id": 14,
        "name": "Risposta del CF / Ufficio"
      },
      "value": "<div><p style=\"margin-top:0pt; margin-bottom:0pt; line-height:150%; widows:0; orphans:0; font-size:11pt\"><span style=\"font-family:Arial\">Il 30</span><span style=\"font-family:Arial\">&#xa0;</span><span style=\"font-family:Arial\">marzo</span><span style=\"font-family:Arial\">&#xa0;</span><span style=\"font-family:Arial\">2024 non si è svolta nessuna giornata delle porte aperte sulla piazza d’armi di Thun. L’interrogazione si riferisce probabilmente alla giornata delle porte aperte della scuola di difesa NBC</span><span style=\"font-family:Arial\">&#xa0;</span><span style=\"font-family:Arial\">77 tenutasi il 5</span><span style=\"font-family:Arial\">&#xa0;</span><span style=\"font-family:Arial\">aprile</span><span style=\"font-family:Arial\">&#xa0;</span><span style=\"font-family:Arial\">2024 a Thun. </span></p><p style=\"margin-top:0pt; margin-bottom:0pt; line-height:150%; widows:0; orphans:0; font-size:11pt\"><span style=\"font-family:Arial\">Nei limiti del possibile è premura dell’esercito proporre vini svizzeri in occasione dei suoi eventi. Durante questa giornata, ai visitatori sono stati serviti vini esteri. La scelta è caduta su questi vini poiché il grossista non aveva bottiglie di vino svizzere della capacità desiderata, ossia 2,5</span><span style=\"font-family:Arial\">&#xa0;</span><span style=\"font-family:Arial\">dl. In seguito i quadri sono stati sensibilizzati riguardo all’importanza di utilizzare prodotti svizzeri e in futuro baderanno ad acquistare vini svizzeri.</span></p></div>"
    },
    {
      "type": {
        "id": 5,
        "name": "Testo depositato"
      },
      "value": "<div><p style=\"margin-top:0pt; margin-bottom:0pt; line-height:150%; widows:0; orphans:0; font-size:11pt\"><span style=\"font-family:Arial\">Sabato 30</span><span style=\"font-family:Arial\"> </span><span style=\"font-family:Arial\">marzo si è svolta la giornata delle porte aperte sulla piazza d’armi di Thun.</span></p><p style=\"margin-top:0pt; margin-bottom:0pt; line-height:150%; widows:0; orphans:0; font-size:11pt\"><span style=\"font-family:Arial\">In quell’occasione è stato servito vino italiano …</span></p><p style=\"margin-top:0pt; margin-bottom:0pt; line-height:150%; widows:0; orphans:0; font-size:11pt\"><span style=\"font-family:Arial\">Molti genitori e ospiti si sono indignati del fatto che il nostro Esercito svizzero promuova vini esteri, dato che il nostro Paese conta numerosi produttori di vino e viticoltori locali.</span></p><p style=\"margin-top:0pt; margin-bottom:0pt; line-height:150%; widows:0; orphans:0; font-size:11pt\"><span style=\"font-family:Arial\">Ho quindi l’onore di invitare il Consiglio federale a rispondere alla domanda seguente:</span></p><p style=\"margin-top:0pt; margin-bottom:0pt; line-height:150%; widows:0; orphans:0; font-size:11pt\"><span style=\"font-family:Arial\">Per quale motivo il nostro esercito ai suoi eventi valorizza vini esteri invece di promuovere vini svizzeri?</span></p></div>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titolo dell'oggetto"
      },
      "value": "Vino estero per le giornate delle porte aperte dell'esercito?"
    }
  ],
  "title": "Vino estero per le giornate delle porte aperte dell'esercito?"
}