  "texts": [
    {
      "type": {
        "id": 5,
        "name": "Texte déposé"
      },
      "value": "<p><span style=\"color:black;\">-&nbsp;Les principes définis dans la stratégie de prévention et de lutte contre les incendies de forêt sont-ils mis en œuvre&nbsp;?</span><br>-<span style=\"color:black;\">&nbsp;En cas d’incendie de forêt de grande ampleur, les compétences de la Confédération et des cantons sont-elles clairement définies&nbsp;?</span><br>-<span style=\"color:black;\">&nbsp;Quelles nouvelles technologies seraient utilisées aujourd’hui pour éteindre un incendie de forêt&nbsp;?</span><br>-<span style=\"color:black;\">&nbsp;La Confédération dispose-t-elle actuellement de suffisamment de ressources pour lutter contre un incendie de forêt de grande ampleur&nbsp;?</span></p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titre de l'objet"
      },
      "value": "La stratégie de prévention et de lutte contre les incendies de forêt est-elle mise en œuvre ?"
    }
  ],
  "title": "La stratégie de prévention et de lutte contre les incendies de forêt est-elle mise en œuvre ?"
