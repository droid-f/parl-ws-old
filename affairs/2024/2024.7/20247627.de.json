  "texts": [
    {
      "type": {
        "id": 5,
        "name": "Eingereichter Text"
      },
      "value": "<p>Mit welchen Massnahmen plant die Bundeskanzlei, mehr Transparenz über die Herkunft von Unterschriften und über die Art und Weise der Sammlung von Unterschriften zu gewährleisten, um Betrugsfälle rechtzeitig zu erkennen?<br>&nbsp;</p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titel des Geschäftes"
      },
      "value": "Welche Massnahmen sind geplant, um bei der Sammlung von Unterschriften für Volksinitiativen und Referenden für mehr Transparenz zu sorgen?"
    }
  ],
  "title": "Welche Massnahmen sind geplant, um bei der Sammlung von Unterschriften für Volksinitiativen und Referenden für mehr Transparenz zu sorgen?"
