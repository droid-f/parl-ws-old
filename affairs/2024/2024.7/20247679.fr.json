  "texts": [
    {
      "type": {
        "id": 5,
        "name": "Texte déposé"
      },
      "value": "<p>Dans le prolongement de ma question 24.7571,<br>à combien le Conseil fédéral évalue-t-il l'effectif des personnels supplémentaires de l'OFDF qui serait nécessaire pour instaurer aux frontières suisses des contrôles de personnes analogues à ceux que l'Allemagne vient de généraliser pour six mois à ses propres frontières ?</p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titre de l'objet"
      },
      "value": "Augmenter l'effectif des douaniers pour contrôler mieux nos frontières ?"
    }
  ],
  "title": "Augmenter l'effectif des douaniers pour contrôler mieux nos frontières ?"
}