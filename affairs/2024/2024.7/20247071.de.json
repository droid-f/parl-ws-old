  "texts": [
    {
      "type": {
        "id": 5,
        "name": "Eingereichter Text"
      },
      "value": "<p><span style=\"color:black;\">China hat am 30.1.24 das Abkommen von 2015 über die Route M503 in der Taiwanstrasse einseitig gekündigt, was eine Bedrohung für die internationale Luftsicherheit darstellt.</span><br><span style=\"color:black;\">- Welche Massnahmen trifft der Bund, um die rund 350 Schweizer in Taiwan zu schützen und die Sicherheit von Tausenden Schweizer Flugreisenden sicherzustellen?</span><br><span style=\"color:black;\">- Wird er gemäss den ICAO-Vorschriften Peking auffordern, mit Taipeh zu verhandeln, damit der friedliche Status quo in der Taiwanstrasse wiederhergestellt werden kann?</span></p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titel des Geschäftes"
      },
      "value": "Gefährdung der Sicherheit von Flugpassagieren in der Taiwan-Strasse"
    }
  ],
  "title": "Gefährdung der Sicherheit von Flugpassagieren in der Taiwan-Strasse"
