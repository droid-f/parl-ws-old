  "texts": [
    {
      "type": {
        "id": 5,
        "name": "Eingereichter Text"
      },
      "value": "<p><span style=\"color:black;\">Während der OSZE-Antisemitismuskonferenz im April 2024 kamen die Teilnehmerstaaten überein, den interreligiösen und interkulturellen Dialog zu fördern. Dies ist im Hinblick auf die Wahrung eines friedlichen Zusammenlebens von grosser Bedeutung.</span><br><span style=\"color:black;\">1. Welche Massnahmen unternimmt der Bund im Bereich des interreligiösen Dialogs bereits heute?</span><br><span style=\"color:black;\">2. Wie arbeitet er mit den Kantonen dabei zusammen?</span><br><span style=\"color:black;\">2. Was plant der Bundesrat in Zukunft noch zu unternehmen?</span></p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titel des Geschäftes"
      },
      "value": "OSZE-Antisemitismuskonferenz: Staaten wollen interreligiösen Dialog fördern. Was tut die Schweiz?"
    }
  ],
  "title": "OSZE-Antisemitismuskonferenz: Staaten wollen interreligiösen Dialog fördern. Was tut die Schweiz?"
