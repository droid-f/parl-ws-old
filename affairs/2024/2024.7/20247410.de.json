  "texts": [
    {
      "type": {
        "id": 14,
        "name": "Antwort BR / Büro"
      },
      "value": "<div><p style=\"margin-top:0pt; margin-bottom:0pt; line-height:18pt\"><span style=\"font-family:Arial; font-size:12pt\">Der Service-public-Auftrag der SRG ist mit den Bereichen Information, Bildung, Kultur, Unterhaltung und Sport umfassend definiert. Der Bundesrat äussert sich nicht zu den Programminhalten der SRG. Die Bundesverfassung garantiert Radio und Fernsehen Unabhängigkeit und Programmautonomie.</span></p></div>"
    },
    {
      "type": {
        "id": 5,
        "name": "Eingereichter Text"
      },
      "value": "<p>SRF 1 hat am 5. Juni während einer Sondersendung 4 Stunden lang die Übung der Luftwaffe auf der A1 übertragen.&nbsp;<br>Ist der Bundesrat der Ansicht, dass es sich dabei um einen \"Service Public\" im Rahmen des Verfassungsauftrags handelt?</p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titel des Geschäftes"
      },
      "value": "4 Stunden Armeepropaganda - ist das Service Public?"
    }
  ],
  "title": "4 Stunden Armeepropaganda - ist das Service Public?"
}