  "texts": [
    {
      "type": {
        "id": 5,
        "name": "Eingereichter Text"
      },
      "value": "<p>Nach Art. 44 Abs. 6 ATSG sind die Tonaufnahmen der Gutachter-Interviews in die Akten des Versicherungsträgers aufzunehmen. Werden bei den IV-Stellen die Akten bestellt, befinden sich die Aufnahmen aber regelmässig nicht in den IV-Akten. Diese werden nur nach besonderer Anfrage elektronisch übermittelt und sind nur für kurze Zeit temporär abhörbar und dürfen auch nicht gespeichert werden.&nbsp;<br>Mit welcher Legitimation missachtet die IV-Verwaltung den Willen des Gesetzgebers?</p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titel des Geschäftes"
      },
      "value": "Missachtung des gesetzgeberischen Willens durch die IV-Verwaltung"
    }
  ],
  "title": "Missachtung des gesetzgeberischen Willens durch die IV-Verwaltung"
}