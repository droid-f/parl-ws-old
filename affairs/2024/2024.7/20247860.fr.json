  "texts": [
    {
      "type": {
        "id": 5,
        "name": "Texte déposé"
      },
      "value": "<p>- Que se passe-t-il lorsqu’une personne est victime de discrimination ou de violence durant son service&nbsp;?<br>- Comment un soutien immédiat, indépendant et neutre est-il garanti&nbsp;?<br>- Quelles démarches sont entreprises pour s’assurer que la victime n’ait pas à se trouver à proximité de l’auteur du tort&nbsp;?</p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titre de l'objet"
      },
      "value": "Discrimination et violence sexualisée au sein de l’armée : comment les victimes sont-elles immédiatement aidées et protégées ?"
    }
  ],
  "title": "Discrimination et violence sexualisée au sein de l’armée : comment les victimes sont-elles immédiatement aidées et protégées ?"
