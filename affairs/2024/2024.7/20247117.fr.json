  "texts": [
    {
      "type": {
        "id": 5,
        "name": "Texte déposé"
      },
      "value": "<p><span style=\"color:black;\">Dans sa réponse à l’interpellation 21.4259,&nbsp;</span><span style=\"background-color:white;color:#1E1E1E;\">le Conseil fédéral rappelle l’importance de l’aviation sur les émissions de CO2.</span><br><span style=\"background-color:white;color:#1E1E1E;\">Comment entend-il expliquer à la population que les jets privés, par exemple, ne font pas encore partie des mesures de la Confédération pour réduire les GES en Suisse ?</span></p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titre de l'objet"
      },
      "value": "Quelles mesures climatiques de la part de la Confédération sur les jets privés ?"
    }
  ],
  "title": "Quelles mesures climatiques de la part de la Confédération sur les jets privés ?"
}