  "texts": [
    {
      "type": {
        "id": 5,
        "name": "Eingereichter Text"
      },
      "value": "<p><span style=\"color:rgb(69,69,69);\">Die Credit Suisse (Wert ca. 35 Mia.) wurde für 3 Mia. von der UBS AG übernommen. Vom Bundesrat zur Beratung beigezogen wurde die Anwaltskanzlei Kraft, Niederer und Frey AG in Zürich, welche im Vorfeld des CS-Deals sowohl für die CS als auch für die UBS tätig war:</span><br><a href=\"https://lawstyle.ch/niederer-kraft-frey-beriet-ubs-ag-und-credit-suisse-ag-bei-der-schmolz-bickenbach-ag-aktienemission).\"><span style=\"color:rgb(0,0,238);\"><u>https://lawstyle.ch/niederer-kraft-frey-beriet-ubs-ag-und-credit-suisse-ag-bei-der-schmolz-bickenbach-ag-aktienemission</u></span></a><span style=\"color:rgb(69,69,69);\">. Art. 12 lit. c BGFA untersagt Interessenkollisionen.&nbsp;</span><br><span style=\"color:rgb(69,69,69);\">Warum fand Art. 12 lit. c BGFA in diesem Fall keine Anwendung?</span></p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titel des Geschäftes"
      },
      "value": "Gilt Art. 12 lit. c BGFA für alle Anwaltskanzleien?"
    }
  ],
  "title": "Gilt Art. 12 lit. c BGFA für alle Anwaltskanzleien?"
}