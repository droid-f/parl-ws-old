  "texts": [
    {
      "type": {
        "id": 5,
        "name": "Eingereichter Text"
      },
      "value": "<p><span style=\"background-color:transparent;color:#000000;\">Die Schweiz hat kommuniziert, bei der Umsetzung des Pariser Übereinkommens ihren national festgelegten Beitrag (<i>Nationally Determined Contribution</i>) dahingehend zu erhöhen, dass sie sich zu Massnahmen verpflichtet, mit denen die Klimaerwärmung auf 1,5° C begrenzt wird.</span><br><span style=\"background-color:transparent;color:#000000;\">Reichen die Massnahmen des Klima- und Innovationsgesetzes und des CO2-Gesetzes, das derzeit revidiert wird, aus, um dieses Ziel zu erreichen?</span></p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titel des Geschäftes"
      },
      "value": "Reichen die Massnahmen der Schweiz aus, um das Ziel, die Klimaerwärmung auf höchstens 1,5° C zu begrenzen, zu erreichen? "
    }
  ],
  "title": "Reichen die Massnahmen der Schweiz aus, um das Ziel, die Klimaerwärmung auf höchstens 1,5° C zu begrenzen, zu erreichen? "
}