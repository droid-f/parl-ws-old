  "texts": [
    {
      "type": {
        "id": 5,
        "name": "Texte déposé"
      },
      "value": "<p><span style=\"color:black;\">Durant la conférence de l'OSCE sur l'antisémitisme, en avril 2024, les États présents ont décidé d'encourager le dialogue interreligieux et interculturel. Une telle mesure est d'une grande importance pour le vivre-ensemble en paix.</span><br><span style=\"color:black;\">1. Quelles mesures la Confédération prend-elle déjà, à l'heure actuelle, dans le domaine du dialogue interreligieux&nbsp;?</span><br><span style=\"color:black;\">2. Sous quelle forme collabore-t-elle avec les cantons&nbsp;?</span><br><span style=\"color:black;\">3. Quelles autres mesures le Conseil fédéral compte-t-il prendre à l'avenir&nbsp;?</span></p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titre de l'objet"
      },
      "value": "Conférence de l'OSCE sur l'antisémitisme&nbsp;: les États souhaitent encourager le dialogue interreligieux. Que fait la Suisse ?"
    }
  ],
  "title": "Conférence de l'OSCE sur l'antisémitisme&nbsp;: les États souhaitent encourager le dialogue interreligieux. Que fait la Suisse ?"
