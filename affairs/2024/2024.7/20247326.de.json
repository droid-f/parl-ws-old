  "texts": [
    {
      "type": {
        "id": 5,
        "name": "Eingereichter Text"
      },
      "value": "<p><span style=\"background-color:white;color:black;\">Der Walliser Staatsrat hat einseitig beschlossen, die dritte Rhonekorrektion in Frage zu stellen. Trotz zweier Umgestaltungen überflutete das Hochwasser der Rhone die Ebene und verursachte in den Jahren 1987, 1993 und 2000 grosse Schäden. Klimatische Ereignisse werden immer häufiger und haben immer gravierendere Auswirkungen.</span><br><span style=\"background-color:white;color:black;\">Wie positioniert sich der Bund zu dieser Kehrtwende, die Finanzierung und den Zeitplan des Projekts, das für die Sicherheit der Bevölkerung von grosser Bedeutung ist, in Frage stellt?</span></p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titel des Geschäftes"
      },
      "value": "Ist die dritte Rhonekorrektion in Gefahr?"
    }
  ],
  "title": "Ist die dritte Rhonekorrektion in Gefahr?"
