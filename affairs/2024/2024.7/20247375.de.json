  "texts": [
    {
      "type": {
        "id": 5,
        "name": "Eingereichter Text"
      },
      "value": "<p>Gibt es eine Möglichkeit während der Bürgenstock Konferenz den Bauern und Jägern den Einsatz von Infrarot-Drohnen nicht zu untersagen, um damit den Mähtot von unzähligen Rehkitzen zu verhindern?</p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titel des Geschäftes"
      },
      "value": "Drohneneinsatz nicht verbieten um damit zahlreiche Rehkitze zu retten"
    }
  ],
  "title": "Drohneneinsatz nicht verbieten um damit zahlreiche Rehkitze zu retten"
