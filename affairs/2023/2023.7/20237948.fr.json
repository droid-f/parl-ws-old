  "texts": [
    {
      "type": {
        "id": 5,
        "name": "Texte déposé"
      },
      "value": "<p><span style=\"color:black;\">Il se dit que dans le cadre de la consultation sur la modification de la loi fédérale permettant d’étendre le champ d’application de la convention collective de travail, le SECO proposera au Conseil fédéral de ne pas mettre en œuvre la motion « Protéger le partenariat social contre des ingérences discutables » (20.4738).</span><br><span style=\"color:black;\">Que fait le Conseil fédéral pour s’assurer que la volonté du Parlement sera respectée et que l’avant-projet de la modification prévoira au moins une variante de mise en œuvre ?</span></p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titre de l'objet"
      },
      "value": "La volonté du Parlement sera-t-elle respectée ?"
    }
  ],
  "title": "La volonté du Parlement sera-t-elle respectée ?"
}