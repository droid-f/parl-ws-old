  "texts": [
    {
      "type": {
        "id": 5,
        "name": "Texte déposé"
      },
      "value": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(69,69,69);\">Le 6&nbsp;septembre 2023, le Conseil fédéral a donné son accord de principe concernant l’autorisation d’une mission de soutien à la sécurité en Haïti.</span><br><span style=\"background-color:rgb(255,255,255);color:rgb(69,69,69);\">- Où en sommes-nous trois mois plus tard ?</span><br><span style=\"background-color:rgb(255,255,255);color:rgb(69,69,69);\">- Quelles sont les implications concrètes de notre pays dans la crise sécuritaire, politique et surtout humanitaire sans précédent ni équivalent au niveau mondial de cet Etat, considéré pourtant dans le passé comme \"La perle des Antilles\" ?</span></p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titre de l'objet"
      },
      "value": "Que faisons-nous pour sauver \"La perle des Antilles\" (Haïti)"
    }
  ],
  "title": "Que faisons-nous pour sauver \"La perle des Antilles\" (Haïti)"
}