    },
    {
      "type": {
        "id": 5,
        "name": "Testo depositato"
      },
      "value": "<div><p style=\"margin-top:0pt; margin-bottom:0pt; line-height:150%; widows:0; orphans:0; font-size:11pt\"><span style=\"font-family:Arial\">Come si presenta l’evoluzione della popolazione con e senza passato migratorio negli anni 1984, 2012, 2021, 2030 e 2050 nelle fasce di età <15</span><span style=\"font-family:Arial\"> </span><span style=\"font-family:Arial\">anni, 15–30</span><span style=\"font-family:Arial\"> </span><span style=\"font-family:Arial\">anni, 30–60</span><span style=\"font-family:Arial\"> </span><span style=\"font-family:Arial\">anni e >60</span><span style=\"font-family:Arial\"> </span><span style=\"font-family:Arial\">anni?</span></p></div>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titolo dell'oggetto"
      },
      "value": "Scenari demografici della Svizzera per il 2050"
