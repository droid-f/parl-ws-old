  "texts": [
    {
      "type": {
        "id": 6,
        "name": "Motivazione"
      },
      "value": "<p><span style=\"color:black;\">La normativa svizzera in materia di garanzia per i difetti della cosa venduta risale al 1910. È dunque giunto il momento per aggiornare le rispettive norme ormai obsolete e non più in linea con le circostanze attuali. Il rapporto del Consiglio federale in adempimento del postulato 18.3248 evidenzia la necessità d’intervento.</span></p>"
    },
    {
      "type": {
        "id": 14,
        "name": "Risposta del CF / Ufficio"
      },
      "value": "Il Consiglio federale propone di accogliere la mozione."
    },
    {
      "type": {
        "id": 5,
        "name": "Testo depositato"
      },
      "value": "<p><span style=\"color:black;\">Il Consiglio federale è incaricato di modificare il diritto svizzero in materia di garanzia secondo le esigenze evidenziate nel postulato 18.3248.</span></p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titolo dell'oggetto"
      },
      "value": "Modernizzazione del diritto in materia di garanzia "
    }
  ],
  "title": "Modernizzazione del diritto in materia di garanzia "
