  "texts": [
    {
      "type": {
        "id": 6,
        "name": "Développement"
      },
      "value": "<p><span style=\"color:black;\">Les règles du droit suisse de la garantie de la chose vendue datent de 1910. Elles ne correspondent plus à la réalité actuelle et sont dépassées, d’où la nécessité d’une révision. Le rapport du Conseil fédéral établi en réponse au postulat 18.3248 présente les domaines où il est nécessaire d’agir.</span></p>"
    },
    {
      "type": {
        "id": 14,
        "name": "Réponse CF / Bureau"
      },
      "value": "Le Conseil fédéral propose d'accepter la motion."
    },
    {
      "type": {
        "id": 5,
        "name": "Texte déposé"
      },
      "value": "<p>La commission charge le Conseil fédéral de réviser le droit de la garantie sur la base du rapport établi en réponse au postulat 18.3248.</p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titre de l'objet"
      },
      "value": "Modernisation du droit de la garantie"
    }
  ],
  "title": "Modernisation du droit de la garantie"
}