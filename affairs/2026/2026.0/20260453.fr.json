  "texts": [
    {
      "type": {
        "id": 5,
        "name": "Texte déposé"
      },
      "value": "<p>L’ordonnance de l’Assemblée fédérale du 23 mars 2007 concernant les indemnités journalières et les indemnités de déplacement des juges du Tribunal fédéral est modifiée de sorte que les forfaits destinés aux juges suppléants et suppléantes passent de 180 à 240 francs pour celles et ceux exerçant une activité indépendante et de 110 à 180 francs ceux destinés aux autres juges.</p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titre de l'objet"
      },
      "value": "Réévaluation des forfaits horaires des juges suppléants et suppléantes du Tribunal fédéral"
    }
  ],
  "title": "Réévaluation des forfaits horaires des juges suppléants et suppléantes du Tribunal fédéral"
