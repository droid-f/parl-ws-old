        "id": 1,
        "name": "Titel des Geschäftes"
      },
      "value": "Jagd auf Autofahrerinnen und Autofahrer über 75 Jahre?"
    }
  ],
  "title": "Jagd auf Autofahrerinnen und Autofahrer über 75 Jahre?"
