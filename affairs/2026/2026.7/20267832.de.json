        "id": 1,
        "name": "Titel des Geschäftes"
      },
      "value": "Auftrag der Kanzlei Homburger bei der Beschaffung des F-35"
    }
  ],
  "title": "Auftrag der Kanzlei Homburger bei der Beschaffung des F-35"
