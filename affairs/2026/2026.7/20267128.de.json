        "id": 1,
        "name": "Titel des Geschäftes"
      },
      "value": "ASAL 2.0: Der absehbare Skandal um die Verzögerungen bei der Auszahlung der Arbeitslosenentschädigungen"
    }
  ],
  "title": "ASAL 2.0: Der absehbare Skandal um die Verzögerungen bei der Auszahlung der Arbeitslosenentschädigungen"
