  "texts": [
    {
      "type": {
        "id": 14,
        "name": "Antwort BR / Büro"
      },
      "value": "<span><p>Nein, der Bund hat sich nicht an den Verfahrenskosten der Firmen beteiligt. Berufs-, Geschäfts- und Fabrikationsgeheimnisse sind private Interessen, die Firmen in eigenem Namen und auf eigene Kosten geltend machen. Soweit sie hierfür Anwälte beauftragen, tragen sie auch diese Kosten selber. </p></span>"
    },
    {
      "type": {
        "id": 5,
        "name": "Eingereichter Text"
      },
      "value": "<p>- Hat der Bund sich an Kosten für Anwälte und Aufwände dieser Firmen im erwähnten Rechtsstreit in irgendeiner Form beteiligt?&nbsp;<br>- Wenn ja, wo und wie hoch sind diese Kosten?&nbsp;</p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titel des Geschäftes"
      },
      "value": "Zu den Rechtsfällen gegen Novavax und Moderna vor dem Bundesverwaltungsgericht (Urteile A-488/2024, A-514/2024 und A-619/2024):"
    }
  ],
  "title": "Zu den Rechtsfällen gegen Novavax und Moderna vor dem Bundesverwaltungsgericht (Urteile A-488/2024, A-514/2024 und A-619/2024):"
