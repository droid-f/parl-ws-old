  "texts": [
    {
      "type": {
        "id": 5,
        "name": "Eingereichter Text"
      },
      "value": "<p>Ich frage den Bundesrat: Wie viele Dokumente der folgenden Kategorien sind derzeit im Umlauf? Wie viele werden pro Jahr neu ausgestellt?</p><p>– Führerausweis für Motorfahrzeuge</p><p>– Schiffsführerausweis</p><p>– Fluglizenz oder Fernpiloten-Zertifikat</p><p>– sonstige Ausweise und Berechtigungen im Zusammenhang mit der Mobilität von Personen und Gütern</p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titel des Geschäftes"
      },
      "value": "Nachweise über Qualifikationen / Berechtigungen im Bereich Mobilität"
    }
  ],
  "title": "Nachweise über Qualifikationen / Berechtigungen im Bereich Mobilität"
}