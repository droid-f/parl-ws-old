  "texts": [
    {
      "type": {
        "id": 5,
        "name": "Texte déposé"
      },
      "value": "<p>L’ordonnance de l’Assemblée fédérale sur les relations internationales du Parlement (RS&nbsp;171.117) sera précisée à la lumière de la Constitution de manière que l’établissement et le maintien de relations internationales de l’Assemblée fédérale avec des institutions d’autres États requièrent l’approbation des deux chambres.</p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titre de l'objet"
      },
      "value": "Approbation par les deux chambres de l’établissement et de l’entretien de relations internationales de l’Assemblée fédérale avec des institutions d’autres États"
    }
  ],
  "title": "Approbation par les deux chambres de l’établissement et de l’entretien de relations internationales de l’Assemblée fédérale avec des institutions d’autres États"
