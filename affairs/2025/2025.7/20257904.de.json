        "id": 1,
        "name": "Titel des Geschäftes"
      },
      "value": "Zusammenarbeit der Schweizer Armee mit US-Nationalgarde von Colorado"
    }
  ],
  "title": "Zusammenarbeit der Schweizer Armee mit US-Nationalgarde von Colorado"
