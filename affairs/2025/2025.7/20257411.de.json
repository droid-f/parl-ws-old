        "id": 1,
        "name": "Titel des Geschäftes"
      },
      "value": "Internationale Gesundheitsvorschriften (IGV): Fehlende Analyse vor weiteren Schritten"
    }
  ],
  "title": "Internationale Gesundheitsvorschriften (IGV): Fehlende Analyse vor weiteren Schritten"
