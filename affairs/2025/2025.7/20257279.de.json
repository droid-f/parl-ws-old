        "id": 1,
        "name": "Titel des Geschäftes"
      },
      "value": "Guillotine-Klausel: Genf leidet, Bern sieht zu"
    }
  ],
  "title": "Guillotine-Klausel: Genf leidet, Bern sieht zu"
