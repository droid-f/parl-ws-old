  "texts": [
    {
      "type": {
        "id": 14,
        "name": "Antwort BR / Büro"
      },
      "value": "<p>Art. 31 Abs. 5 des Geschäftsreglement des Nationalrates besagt, dass thematisch zusammengehörende Fragen gemeinsam beantwortet werden.</p>"
    },
    {
      "type": {
        "id": 5,
        "name": "Eingereichter Text"
      },
      "value": "<p>Auf rund 15 verschiedene Fragen, die von mehreren Parlamentarier/innen gestellt wurden, antwortete das EDA mit der gleichen Antwort.<br>Gab es einen Computer-«Bug»?</p>"
    },
    {
      "type": {
        "id": 1,
        "name": "Titel des Geschäftes"
      },
      "value": "15 Fragen zur Lage in Gaza, 15 identische Antworten!"
    }
  ],
  "title": "15 Fragen zur Lage in Gaza, 15 identische Antworten!"
